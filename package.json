{
  "name": "cs2-rcon-web",
  "version": "0.1.0",
  "description": "Web-based RCON admin tool for Counter-Strike 2 servers",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "dev": "tsc && npm start",
    "test": "tsc && node --disable-warning=ExperimentalWarning --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
